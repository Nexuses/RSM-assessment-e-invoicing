## Postgres (optional, for /submissions dashboard)
DATABASE_URL=postgresql://rsm:rsm@localhost:5432/rsm_assessments?schema=public

# Password for /submissions admin page and API
SUBMISSIONS_PASSWORD=

## Google Sheets (Service Account)
# 1) Create a Google Cloud service account
# 2) Enable "Google Sheets API"
# 3) Create a JSON key for the service account
# 4) Share your spreadsheet with the service account email (Editor access)
#
# Put the FULL JSON content of the key file below (as a single line JSON string).
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
#
# Your spreadsheet id (from the URL)
GOOGLE_SHEETS_SPREADSHEET_ID=17IoNsq0xAWSzJVgwnPC_Ej_eUGucW9iw6iVbvanUunE
#
# Tab names (optional)
GOOGLE_SHEETS_ASSESSMENT_SHEET_NAME=Sheet1
GOOGLE_SHEETS_CONSULTATION_SHEET_NAME=Sheet2

## Email (SMTP) - required for existing email flows
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# RSM contact / inquiry email (reply-to, internal assessment notifications, UI)
RSM_INQUIRY_EMAIL=e-invoice-inquiry@rsm.ae
NEXT_PUBLIC_RSM_INQUIRY_EMAIL=e-invoice-inquiry@rsm.ae

# Optional overrides (defaults shown)
REPLY_TO_EMAIL=e-invoice-inquiry@rsm.ae
INTERNAL_ASSESSMENT_RECIPIENTS=e-invoice-inquiry@rsm.ae
CONSULTATION_RECIPIENTS=anisha@cs.rsm.ae, GRC-Inquiry@RSM.ae, rsm-tech-aaaahib5qyhpf2k6egbqwrugwa@nexuses.slack.com

## AWS S3 (optional, for PDF upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=

## Incomplete assessment reminders (cron)
# Public base URL used in “resume assessment” emails
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
# Shared secret for GET/POST /api/cron/incomplete-assessments
CRON_SECRET=

# Example crontab (every 5 minutes):
# */5 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://YOUR_DOMAIN/api/cron/incomplete-assessments

