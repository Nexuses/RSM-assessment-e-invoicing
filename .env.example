# Postgres
DATABASE_URL=postgresql://rsm:rsm@localhost:5432/rsm_assessments?schema=public

# /submissions admin page
SUBMISSIONS_PASSWORD=

# Google Sheets (service account JSON must be a single line)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional alias for the same spreadsheet ID
# GOOGLE_SHEET_ID=

# AWS S3 (PDF report uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=

# SMTP (e.g. Amazon SES)
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional: comma-separated admin emails for consultation requests
# CONSULTATION_RECIPIENTS=
